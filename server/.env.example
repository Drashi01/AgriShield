# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Database (PostgreSQL + PostGIS)
DATABASE_URL=postgresql://postgres:password@localhost:5432/agrismart_db

# Authentication
JWT_SECRET=super_secret_jwt_key_2026
JWT_EXPIRES_IN=7d

# Google Cloud Storage (AI Pathology Leaf Scans)
# If GCP_PROJECT_ID is empty or bucket not reachable, the system falls back to local disk storage in /uploads
GCP_PROJECT_ID=your_gcp_project
GCS_BUCKET_NAME=agrismart_leaf_scans
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json
